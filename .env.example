# Shared local Ollama service. Ollama ignores the compatibility API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL_DIGEST=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:137m-v1.5-fp16
OLLAMA_EMBEDDING_MODEL_DIGEST=
OLLAMA_EMBEDDING_DIMENSIONS=768

# Optional cloud/OpenAI-compatible provider. Keep separate from Ollama settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Service endpoints added in later setup phases.
MOORCHEH_ONPREM_URL=http://127.0.0.1:8080
MOORCHEH_ONPREM_TIMEOUT=300
LANGGRAPH_POSTGRES_DSN=postgresql://membench:change-me@127.0.0.1:5432/membench
