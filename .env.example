# Shared local Ollama service. Ollama ignores the compatibility API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL_DIGEST=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:137m-v1.5-fp16
OLLAMA_EMBEDDING_MODEL_DIGEST=
OLLAMA_EMBEDDING_DIMENSIONS=768

# TeleMem defaults to the shared Ollama endpoint and isolated local FAISS state.
# Switch TELEMEM_PROVIDER to openai when intentionally testing OpenAI models.
TELEMEM_PROVIDER=ollama
TELEMEM_STORAGE_ROOT=artifacts/memory/telemem
TELEMEM_BUFFER_SIZE=64
TELEMEM_SIMILARITY_THRESHOLD=0.95
TELEMEM_OPENAI_BASE_URL=https://api.openai.com/v1
TELEMEM_OPENAI_CHAT_MODEL=gpt-5-mini
TELEMEM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TELEMEM_OPENAI_EMBEDDING_DIMENSIONS=1536

# Optional cloud/OpenAI-compatible provider. Keep separate from Ollama settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Service endpoints added in later setup phases.
MOORCHEH_ONPREM_URL=http://127.0.0.1:8080
MOORCHEH_ONPREM_TIMEOUT=300
LANGGRAPH_POSTGRES_IMAGE=pgvector/pgvector@sha256:eac621400b7b7ff52493883e41e930e3d104695fea5b68cc0c42370cf7880067
LANGGRAPH_POSTGRES_CONTAINER=membench-langgraph-postgres
LANGGRAPH_POSTGRES_DSN=postgresql://membench:change-me@127.0.0.1:5432/membench

# LangMem is a selective writer over a LangGraph Store. Semantic memory is the
# bounded default; add episodic or procedural as comma-separated values only in
# explicitly versioned experiment conditions.
LANGMEM_PROVIDER=ollama
LANGMEM_WRITER_MODEL=qwen2.5:7b
LANGMEM_WRITER_MODEL_DIGEST=
LANGMEM_EMBEDDING_PROVIDER=ollama
LANGMEM_MEMORY_TYPES=semantic
LANGMEM_ENABLE_DELETES=false
LANGMEM_QUERY_LIMIT=5
LANGMEM_MAX_STEPS=10
LANGMEM_TEMPERATURE=0
LANGMEM_SEED=42
LANGMEM_TIMEOUT_SECONDS=300
LANGMEM_STORAGE_BACKEND=sqlite
LANGMEM_SQLITE_ROOT=artifacts/memory/langmem
LANGMEM_OPENAI_BASE_URL=https://api.openai.com/v1
LANGMEM_OPENAI_WRITER_MODEL=gpt-4o-mini-2024-07-18
LANGMEM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LANGMEM_OPENAI_EMBEDDING_DIMENSIONS=1536
